<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>

		<PackageId>CoreSystem.OpenApi.Swashbuckle</PackageId>
		<Version>1.2.1</Version>
		<AssemblyVersion>1.2.1.0</AssemblyVersion>
		<FileVersion>1.2.1.0</FileVersion>
		<InformationalVersion>1.2.1</InformationalVersion>
		<Authors>Federin Pastor Gutierrez Ortiz</Authors>
		<Description>Reusable OpenAPI and Swagger infrastructure for ASP.NET Core APIs.</Description>
		<PackageTags>OpenAPI;Swagger;Swashbuckle;ASP.NET Core;Documentation;Problem Details;.NET8</PackageTags>
		<PackageReleaseNotes>
			1.2.1: Fixed Development server discovery. Wildcard listen addresses (+, *, 0.0.0.0, [::])
			from ASPNETCORE_URLS are no longer added as Local servers, so the generated document only
			lists URLs that clients can call. Patch release. Requires CoreSystem.OpenApi 2.2.0, which
			changes the default problem schema names (see its release notes).
			1.2.0: Added ProducesConflictProblemAttribute (HTTP 409) for documenting conflict
			problem responses. Minor version bump.
		</PackageReleaseNotes>

		<RepositoryUrl>https://github.com/FEDERIN/CoreSystem</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://federin.github.io/CoreSystem/OpenApi</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CoreSystem.OpenApi" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Core.OpenApi.Swashbuckle.UnitTests" />
	</ItemGroup>

</Project>

