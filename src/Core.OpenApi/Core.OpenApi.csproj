<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>CoreSystem.OpenApi</PackageId>
		<Version>2.1.0</Version>
		<AssemblyVersion>2.1.0.0</AssemblyVersion>
		<FileVersion>2.1.0.0</FileVersion>
		<InformationalVersion>2.1.0</InformationalVersion>
		<Authors>Federin Pastor Gutierrez Ortiz</Authors>
		<Description>Base contracts and models for the CoreSystem OpenAPI infrastructure.</Description>
		<PackageReleaseNotes>
			2.1.0: Added ProducesConflictProblemAttribute (HTTP 409) for documenting conflict
			problem responses. Minor version bump.
		</PackageReleaseNotes>
		<RepositoryUrl>https://github.com/FEDERIN/CoreSystem</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/FEDERIN/CoreSystem/tree/main/src/Core.OpenApi</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.OpenApi" />
	</ItemGroup>

	<ItemGroup>

	</ItemGroup>
<ItemGroup><FrameworkReference Include="Microsoft.AspNetCore.App" /></ItemGroup>	<ItemGroup>
		<InternalsVisibleTo Include="Core.OpenApi.Swashbuckle" />
		<InternalsVisibleTo Include="Core.OpenApi.Swashbuckle.UnitTests" />
	</ItemGroup>
</Project>