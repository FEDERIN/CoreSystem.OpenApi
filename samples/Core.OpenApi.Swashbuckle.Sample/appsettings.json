{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenApi": {
    "Title": "Sample API",
    "Description": "Demo of Core.OpenApi.Swashbuckle",
    "Version": "v1",
    "Bearer": {
      "Enabled": true,
      "SchemeName": "bearer",
      "HeaderName": "Authorization",
      "Scheme": "bearer",
      "BearerFormat": "JWT",
      "Description": "JWT Authorization header. Example: Bearer {token}"
    }
  }
}
